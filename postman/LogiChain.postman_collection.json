{
  "info": {
    "_postman_id": "79817c26-41f6-46de-b828-c4dd0d742e95",
    "name": "LogiChain - Grupo 4",
    "description": "Coleccion de pruebas para los microservicios Inventario, Transporte y Facturacion (574 Desarrollo de Aplicaciones de Vanguardia). Ejecutar con el Collection Runner en orden (de arriba a abajo) usando el Environment 'LogiChain - Local'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Inventario",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventarioUrl}}/health",
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Servicio correcto', () => pm.expect(pm.response.json().servicio).to.eql('Inventario'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar bodegas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventarioUrl}}/bodegas",
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Es un arreglo con al menos 2 bodegas', () => { pm.expect(body).to.be.an('array'); pm.expect(body.length).to.be.at.least(2); });",
                  "const origen = body.find(b => b.codigo === 'BOD-01') || body[0];",
                  "const destino = body.find(b => b.codigo === 'BOD-02') || body[1];",
                  "pm.environment.set('bodegaOrigenId', origen.id);",
                  "pm.environment.set('bodegaDestinoId', destino.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener bodega por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventarioUrl}}/bodegas/{{bodegaOrigenId}}",
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tiene el id esperado', () => pm.expect(pm.response.json().id).to.eql(Number(pm.environment.get('bodegaOrigenId'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventarioUrl}}/productos",
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Es un arreglo con al menos 1 producto', () => { pm.expect(body).to.be.an('array'); pm.expect(body.length).to.be.at.least(1); });",
                  "pm.environment.set('productoId', body[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar stock por bodega y producto",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventarioUrl}}/bodegas/{{bodegaOrigenId}}/stock/{{productoId}}",
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Respuesta tiene la forma esperada', () => { pm.expect(body).to.have.property('bodegaId'); pm.expect(body).to.have.property('productoId'); pm.expect(body).to.have.property('cantidad'); });",
                  "pm.environment.set('stockInicial', body.cantidad);"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar salida mayor al stock (R1: debe rechazar)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{inventarioUrl}}/movimientos-stock",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"solicitudId\": \"{{$guid}}\",\n  \"tipo\": \"Salida\",\n  \"productoId\": \"{{productoId}}\",\n  \"bodegaOrigenId\": \"{{bodegaOrigenId}}\",\n  \"cantidad\": 999999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409 - saldo insuficiente', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar salida válida (R1 dentro del saldo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{inventarioUrl}}/movimientos-stock",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"solicitudId\": \"{{$guid}}\",\n  \"tipo\": \"Salida\",\n  \"productoId\": \"{{productoId}}\",\n  \"bodegaOrigenId\": \"{{bodegaOrigenId}}\",\n  \"cantidad\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Respuesta tiene id y detalles', () => { pm.expect(body).to.have.property('id'); pm.expect(body.detalles).to.be.an('array'); });",
                  "pm.environment.set('movimientoId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener movimiento por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventarioUrl}}/movimientos-stock/{{movimientoId}}",
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('El id coincide', () => pm.expect(pm.response.json().id).to.eql(pm.environment.get('movimientoId')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Transporte",
