            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Estado inicial Pendiente', () => pm.expect(body.estado).to.eql('Pendiente'));",
                  "pm.environment.set('envioAId', body.id);",
                  "pm.environment.set('envioAVersion', body.version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear envío B (para probar rechazos)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{transporteUrl}}/envios",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rutaId\": \"{{rutaId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
