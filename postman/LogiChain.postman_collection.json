          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Estado actualizado a Entregado', () => pm.expect(body.estado).to.eql('Entregado'));",
                  "pm.environment.set('envioAVersion', body.version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener envío A por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{transporteUrl}}/envios/{{envioAId}}",
            "description": ""
