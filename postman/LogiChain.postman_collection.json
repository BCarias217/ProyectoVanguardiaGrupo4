            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Estado actualizado', () => pm.expect(body.estado).to.eql('EnTransito'));",
                  "pm.environment.set('envioAVersion', body.version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Envío A: pasar a Entregado",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
