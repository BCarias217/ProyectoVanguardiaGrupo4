            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"Entregado\",\n  \"version\": \"{{envioBVersion}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409 - transición inválida', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Envío A: pasar a EnTransito",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{transporteUrl}}/envios/{{envioAId}}/estado",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"EnTransito\",\n  \"version\": \"{{envioAVersion}}\"\n}",
